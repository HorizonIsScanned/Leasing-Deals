# Website (Vercel → Settings → Environment Variables)
SITE_PASSWORD=

# Lauf (GitHub → Settings → Secrets and variables → Actions → Secrets), alles optional:
# TELEGRAM_BOT_TOKEN=     Token von @BotFather; Chat-ID wird nach /start an den Bot automatisch erkannt
# TELEGRAM_CHAT_ID=       nur nötig, wenn die automatische Erkennung nicht klappt
# NTFY_TOPIC=            Push über die App „ntfy“ (kostenlos, ohne Konto); langes zufälliges Thema
# RESEND_API_KEY=         Mail-Alarm über Resend
# MAIL_FROM=              z. B. Leasing-Radar <radar@deine-domain.de> (ohne eigene Domain: onboarding@resend.dev)
# MAIL_TO=                Empfänger, mehrere mit Komma
# ANTHROPIC_API_KEY=      KI liest mydealz-Deals, deren Titel keine Rate nennt
# Variable (nicht Secret): SITE_URL=https://leasing-radar.vercel.app
